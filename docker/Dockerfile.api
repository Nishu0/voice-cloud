FROM golang:1.25-alpine AS build
WORKDIR /src
ENV CGO_ENABLED=0

RUN go install -tags='no_postgres no_clickhouse no_mssql no_mysql no_vertica no_ydb no_turso' \
    github.com/pressly/goose/v3/cmd/goose@v3.26.0

COPY db/go.mod ./db/go.mod
COPY apps/api/go.mod apps/api/go.sum ./apps/api/
COPY apps/worker/go.mod ./apps/worker/go.mod
RUN --mount=type=cache,target=/go/pkg/mod go -C apps/api mod download

COPY db ./db
COPY apps/api ./apps/api
COPY apps/worker ./apps/worker
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    go -C apps/api build -trimpath -ldflags='-s -w' -o /out/api . && \
    go -C apps/worker build -trimpath -ldflags='-s -w' -o /out/worker .

FROM alpine:3.22 AS production
RUN apk add --no-cache bash ca-certificates python3 && \
    addgroup -g 10001 app && adduser -D -u 10001 -G app app && \
    mkdir /data && chown app:app /data
WORKDIR /app
COPY --from=build /out/api /out/worker /usr/local/bin/
COPY --from=build /go/bin/goose /usr/local/bin/goose
COPY db/migrations ./db/migrations
COPY scripts/seed.py ./scripts/seed.py
COPY docker/backend-entrypoint.sh ./docker/backend-entrypoint.sh
ENV DB_PATH=/data/voice-cloud.db API_ADDR=0.0.0.0:8080
USER app
EXPOSE 8080
ENTRYPOINT ["/bin/bash", "/app/docker/backend-entrypoint.sh"]
